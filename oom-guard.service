[Unit]
Description=oom-guard: reap workers (PROC_PATTERN) under memory pressure to avoid OOM hangs
Documentation=man:systemd.timer(5)

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=idle
# Override tunables here if you don't want the script defaults, e.g.:
#   Environment=PROC_PATTERN=claude.exe
#   Environment=MEM_MIN_KB=120000
#   Environment=MEM_TARGET_KB=200000
#   Environment=PROTECT_ACTIVE=1
#   Environment=GRACE_SECS=10
#   Environment=IDLE_SECS=0      # >0 also reaps long-idle workers regardless of memory
ExecStart=%h/.local/bin/oom-guard.sh
